---
import Base from '../../layouts/Base.astro';
import Person from '../../components/Person.astro';
import coachesData from '../../data/coaches.json';
const coaches = coachesData.people;
import rosterData from '../../data/coach-roster.json';
const roster = rosterData.people;

const tags = ['Current Coach', '2024 Cohort', '2023 Cohort', 'Launch Network'];
const id = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
// CSS-only filter: when a tag's radio is checked, hide everyone without that tag.
const css = '.empty{display:none}' + tags.map(t => `.dir:has(input[value="${id(t)}"]:checked) .people>li:not([data-tags~="${id(t)}"]){display:none}` +
  `.dir:has(input[value="${id(t)}"]:checked) .empty{display:${coaches.some(c => c.tags.includes(t)) ? 'none' : 'block'}}`).join('');
---
<Base
  title="Meet Our Coaches"
  description="Meet the Level Up Cincinnati volunteer coaches and Launch Network members guiding first-generation college students at UC."
  image="coach-group"
  crumbs={[{ name: 'Our Coaches', path: '/coaches' }]}
>
  <section class="hero on-navy">
    <div class="wrap narrow">
      <p class="eyebrow">Coach directory</p>
      <h1>Meet our coaches &amp; Launch Network</h1>
      <p class="lede">Explore our dedicated network of coaches and Launch Network members — the individuals shaping the next generation of leaders.</p>
    </div>
  </section>

  <section class="section dir" aria-labelledby="dir-h">
    <div class="wrap">
      <h2 id="dir-h" class="visually-hidden">Coach directory</h2>
      <fieldset class="filters">
        <legend class="visually-hidden">Filter coaches</legend>
        <label><input type="radio" name="f" value="all" checked /><span>All</span></label>
        {tags.map(t => <label><input type="radio" name="f" value={id(t)} /><span>{t}</span></label>)}
      </fieldset>
      <ul class="people">
        {coaches.map(c => <Person name={c.name} photo={c.photo} lines={[c.title, c.company, c.tags.join(' · ')]} href={`/coaches/${c.slug}`} linkedin={c.linkedin} tags={c.tags.map(id).join(' ')} />)}
      </ul>
      <p class="empty muted">No one in this group yet.</p>
      <div class="center" style="margin-top:3rem">
        <h2>There's a spot for you.</h2>
        <p>See all {roster.length} current coaches on our <a href="/become-a-coach#coaches">Become a Coach page</a>.</p>
        <a class="btn btn-coral" href="/become-a-coach">Become a Coach</a>
      </div>
    </div>
  </section>
  <style set:html={css}></style>
</Base>
