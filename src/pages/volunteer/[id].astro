---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FormHidden from '../../components/FormHidden.astro';
import site from '../../data/site.json';
import vol from '../../data/volunteer.json';

// A sign-up page for each event whose signups are open.
export function getStaticPaths() {
  return vol.events.filter(e => e.open).map(e => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const roles = e.roles as { name: string; description?: string; status?: string }[];
---
<Base
  title={`Volunteer: ${e.title}`.length > 38 ? e.title : `Volunteer: ${e.title}`}
  description={`${e.when}${e.location ? ` at ${e.location}` : ''}. ${e.summary}`}
  image="home-pd-day"
  crumbs={[{ name: 'Volunteer', path: '/volunteer' }, { name: e.title, path: `/volunteer/${e.id}` }]}
>
  <section class="hero on-navy">
    <div class="wrap narrow">
      <p><a class="text-link" href="/volunteer">← All volunteer events</a></p>
      <h1>{e.title}</h1>
      <p class="event-meta" style="color:var(--blue-gray)"><span><Icon name="calendar" size={18} />{e.when}</span>{e.location && <span><Icon name="pin" size={18} />{e.location}</span>}</p>
      <p class="lede">{e.summary}</p>
      {e.crew && <p><strong>{e.crew}</strong></p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <form class="form" method="POST" action={site.formAction}>
        <FormHidden subject={`Volunteer signup: ${e.title}`} />
        <input type="hidden" name="event" value={e.title} />
        <fieldset class="role-pick">
          <legend><h2>Pick your role</h2></legend>
          {roles.map((r, i) => (
            <label class="role">
              <input type="radio" name="role" value={r.name} required disabled={r.status === 'Full'} checked={false} />
              <b>{r.name}</b>
              <span class:list={['status', r.status === 'Full' ? 'status-soon' : 'status-open', 'left']}>{r.status || 'Open'}</span>
              {r.description && <span class="desc">{r.description}</span>}
            </label>
          ))}
        </fieldset>
        <h2 style="margin-top:1.5rem">Your info</h2>
        <div class="half">
          <div class="field"><label for="v-name">Name <span class="req">(required)</span></label><input type="text" id="v-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="v-email">Email <span class="req">(required)</span></label><input type="email" id="v-email" name="email" autocomplete="email" required /></div>
        </div>
        <div class="half">
          <div class="field"><label for="v-company">Company <span class="req">(optional)</span></label><input type="text" id="v-company" name="company" autocomplete="organization" /></div>
          <div class="field"><label for="v-phone">Phone <span class="req">(optional)</span></label><input type="tel" id="v-phone" name="phone" autocomplete="tel" /></div>
        </div>
        <button class="btn btn-coral btn-arrow" type="submit">Sign me up</button>
        <p class="small muted">We'll confirm your role by email. Questions? <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={`tel:+1${site.phone.replace(/-/g, '')}`}>{site.phone}</a></p>
      </form>
    </div>
  </section>
</Base>
