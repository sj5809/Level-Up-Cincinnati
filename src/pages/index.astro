---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import EventItem from '../components/EventItem.astro';
import site from '../data/site.json';
import coachRoster from '../data/coach-roster.json';
import scholarRoster from '../data/scholar-roster.json';
import { getEvents } from '../lib/events';

const { upcoming } = await getEvents();
const next = upcoming[0];
const s = site.stats;
const coaches = coachRoster.people;
const scholars = scholarRoster.people;
// Interleave real coach and scholar photos for the "family" wall.
const faces = [];
const withPhoto = (a: any[], role: string) => a.filter(p => p.photo).map(p => ({ ...p, role }));
const [cs, ss] = [withPhoto(coaches, 'coach'), withPhoto(scholars, 'scholar')];
for (let i = 0; i < Math.max(cs.length, ss.length); i++) { if (ss[i]) faces.push(ss[i]); if (cs[i]) faces.push(cs[i]); }

const paths = [
  { id: 'coach', icon: 'coach', label: 'Mentor a student', title: 'Become a coach', img: 'home-pair', alt: 'A Level Up scholar and coach together',
    text: 'Walk alongside a first-generation student through college and beyond. You bring the relationship; we run the calendar and support you every step.',
    facts: [`${s.coachHours.replace('~', 'About ')} — one in-person meeting plus quick check-ins`, 'A two-year commitment to one scholar', 'One-day orientation in July, then Match Day in August', 'Dedicated staff support and monthly conversation topics'],
    quote: ['So proud to be a mentor for Level Up Cincinnati! They are run professionally and with so much heart.', 'Jessica K., Emily’s Coach'],
    cta: ['Apply to be a coach', '/become-a-coach#apply'], more: ['See a year as a coach', '/your-year-as-a-coach'] },
  { id: 'volunteer', icon: 'volunteer', label: 'Lend a hand at events', title: 'Volunteer', img: 'home-moment', alt: 'Level Up students at a personal development event',
    text: 'Share your time, skills, or network at events, workshops, and professional development sessions.',
    facts: ['Pick an event and a role that fits your schedule', 'Events, workshops, and professional development sessions', ...(next ? [`Next up: ${next.data.title} — ${next.data.date!.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'long', day: 'numeric' })}`] : [])],
    cta: ['Find a volunteer shift', site.volunteerUrl], more: ['See upcoming events', '/events'] },
  { id: 'partner', icon: 'partner', label: 'Open doors for my company', title: 'Partner or sponsor', img: 'home-networking', alt: 'Level Up students networking with Cincinnati professionals',
    text: 'Create internships, sponsor programs and events, or open career doors for students ready to launch.',
    facts: [`Join ${s.partners} partners across ${s.industries} industries`, 'Meaningful volunteer opportunities for your team', 'A pipeline of driven first-generation talent', `Sponsor events like Aiming for Opportunity (${s.afoRaised} raised)`],
    cta: ['Partner with us', '/our-partners#partner-form'], more: ['Sponsor an event', '/aiming-for-opportunity#sponsor'] },
  { id: 'donate', icon: 'heart', label: 'Fund a scholar', title: 'Donate', img: 'donate-martha', alt: 'Martha, a Level Up scholar',
    text: 'Your gift funds coaching, scholarships, and career development for first-generation college students.',
    facts: ['100% of gifts support programming', 'Tax-deductible 501(c)(3) — EIN ' + site.ein, 'Candid Seal of Transparency, public Form 990s'],
    quote: ['Level Up has changed my life. It has given me a community of support that I didn’t know I needed.', 'Martha, Level Up Scholar'],
    cta: ['Give today', '/donate'], more: ['See our Impact Report', site.impactUrl] },
  { id: 'student', icon: 'student', label: "I'm a UC student", title: 'For Level Up scholars', img: 'students-hero', alt: 'Two Level Up scholars at the University of Cincinnati',
    text: "There's no application — Level Up scholars are selected in partnership with UC based on first-generation status and demonstrated potential.",
    facts: ['Two dedicated coaches through your UC journey', 'Workshops on money, wellness, and career skills', "Access to Cincinnati's professional Launch Network", 'Support for up to 5 years of undergrad'],
    cta: ['Access the Scholar App', site.scholarAppUrl], more: ['How the program works', '/students'] },
];

const journey = [
  { icon: 'student', when: "UC's incoming class", title: 'Selected at UC', text: 'No application: scholars are chosen with UC admissions based on first-gen status and demonstrated potential.' },
  { icon: 'coach', when: 'August', title: 'Match Day', text: 'Each scholar meets their Transition Coach at our biggest celebration of the year.' },
  { icon: 'handshake', when: 'Years 1–2', title: 'Transition Coach', text: 'A college graduate who can relate helps them navigate the move into college life.' },
  { icon: 'partner', when: 'Years 3–4', title: 'Career Coach', text: 'A leader in their field shares industry insight — plus Networking Month and Professional Development Day.' },
  { icon: 'launch', when: 'Graduation & beyond', title: 'Launch', text: `The Launch Network opens doors: ${s.alignedJobs} of jobs and internships align to their major.` },
];
const card = '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2rem)';
---
<Base
  title="Level Up Cincinnati — Coaches for First-Gen Students"
  description="We match first-generation college students at UC with volunteer coaches and a professional network. Become a coach, volunteer, partner, or donate."
>
  <section class="hero-bleed on-navy">
    <div class="bg"><Img src="home-hero" alt="" priority sizes="(min-width: 56rem) 55vw, 110vw" widths={[480, 640, 800, 1080, 1440, 1600]} /></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">First-gen college students · University of Cincinnati</p>
        <h1>Every student deserves someone in their <span class="hl">corner.<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 C 80 4, 200 2, 296 12" /></svg></span></h1>
        <p class="lede">We match first-generation college students with dedicated coaches and a professional community that opens real doors — to internships, careers, and confidence.</p>
        <div class="btn-row">
          <a class="btn btn-coral btn-arrow" href="/become-a-coach">Be Someone's Coach</a>
          <a class="btn btn-outline" href={site.impactUrl}>Explore Our Impact</a>
        </div>
        <p class="hero-trust"><span><Icon name="check" size={18} />University of Cincinnati partner since 2022</span><span><Icon name="check" size={18} />501(c)(3) nonprofit</span></p>
      </div>
    </div>
  </section>

  <section class="stats-float" aria-labelledby="results">
    <div class="wrap">
      <h2 id="results" class="visually-hidden">Our results</h2>
      <dl class="stats">
        <div><dt>program satisfaction rating from our scholars</dt><dd>{s.satisfaction}</dd></div>
        <div><dt>average cumulative GPA</dt><dd>{s.gpa}</dd></div>
        <div><dt>Dean's List rate</dt><dd>{s.deansList}</dd></div>
        <div><dt>jobs &amp; internships aligned to major</dt><dd>{s.alignedJobs}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section chooser" aria-labelledby="paths">
    <div class="wrap">
      <header class="head-center">
        <p class="eyebrow">Get involved</p>
        <h2 id="paths">There's a place for you in this story.</h2>
        <p class="lede">Every coach, volunteer, partner, and donor helps a first-generation student get closer to the future they deserve.</p>
      </header>
      <fieldset class="choices">
        <legend>I want to…</legend>
        {paths.map((p, i) => (
          <label class="choice"><input type="radio" name="path" value={p.id} checked={i === 0} /><span class="ic"><Icon name={p.icon as any} size={20} /></span>{p.label}</label>
        ))}
      </fieldset>
      {paths.map(p => (
        <article class="path-panel" data-path={p.id} aria-labelledby={`path-${p.id}`}>
          <div>
            <h3 id={`path-${p.id}`} style="font-size:clamp(1.5rem,1.2rem + 1.2vw,2rem)">{p.title}</h3>
            <p class="lede">{p.text}</p>
            <ul class="facts">{p.facts.map(f => <li><Icon name="check" size={20} />{f}</li>)}</ul>
            {p.quote && <blockquote class="quote" style="margin-bottom:1.5rem"><p style="font-size:1.125rem">“{p.quote[0]}”</p><footer><cite>{p.quote[1]}</cite></footer></blockquote>}
            <div class="btn-row">
              <a class={`btn ${p.id === 'donate' ? 'btn-coral' : 'btn-navy'} btn-arrow`} href={p.cta[1]}>{p.cta[0]}</a>
              <a class="text-link arrow" href={p.more[1]}>{p.more[0]}</a>
            </div>
          </div>
          <Img src={p.img} alt={p.alt} sizes="(min-width: 56rem) 30rem, calc(100vw - 4rem)" />
        </article>
      ))}
    </div>
  </section>

  <section class="section soft" aria-labelledby="why">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2 id="why">Coaching and support when it's needed most.</h2>
        <p>First-generation college students often start without the networks, guidance, and resources their peers take for granted. That gap doesn't close on its own.</p>
        <p>Level Up pairs each scholar with a dedicated coach and a community of professionals who show up consistently. Through one-on-one coaching, professional development, and real-world connections, we help students build the confidence and careers they've earned.</p>
        <a class="btn btn-navy btn-arrow" href="/our-vision">Read our story</a>
      </div>
      <Img src="home-coaching" alt="A Level Up mentor and student in a coaching session" sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)" />
    </div>
  </section>

  <section class="section on-navy" aria-labelledby="journey">
    <div class="wrap">
      <header class="head-center">
        <p class="eyebrow">A scholar's journey</p>
        <h2 id="journey">From first day on campus to first day on the job.</h2>
        <p class="lede">Two coaches, a community, and a professional network — at the moments that matter most.</p>
      </header>
      <ol class="journey">
        {journey.map(j => <li><span class="step-ic"><Icon name={j.icon as any} /></span><p class="when">{j.when}</p><h3>{j.title}</h3><p>{j.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="programs">
    <div class="wrap">
      <header class="head-center">
        <p class="eyebrow">Our programs</p>
        <h2 id="programs">The support behind every student.</h2>
      </header>
      <div class="grid grid-3">
        <article class="card">
          <div class="card-media"><Img src="home-pd-day" alt="Level Up Cincinnati Professional Development Day" sizes={card} /></div>
          <h3>Personal Development</h3>
          <p>Workshops, retreats, and real conversations that help students build self-awareness, resilience, and the soft skills that open doors.</p>
        </article>
        <article class="card">
          <div class="card-media"><Img src="home-women" alt="Level Up Cincinnati women scholars and coaches" sizes={card} /></div>
          <h3>1-on-1 Growth Coaching</h3>
          <p>Every student is paired with a dedicated coach — a consistent, trusted guide who helps them navigate college, career, and everything in between.</p>
        </article>
        <article class="card">
          <div class="card-media"><Img src="home-networking" alt="Level Up Cincinnati students networking with professionals" sizes={card} /></div>
          <h3>Launch Network</h3>
          <p>Students gain access to Cincinnati's professional community — real connections that lead to internships, mentorship, and careers after graduation.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section on-navy" aria-labelledby="stories">
    <div class="wrap split">
      <Img src="home-tricia-stephanie" alt="Level Up Cincinnati scholar and coach in conversation" sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)" />
      <div>
        <h2 id="stories" class="visually-hidden">Scholar and coach stories</h2>
        <blockquote class="quote" style="margin-bottom:1.25rem">
          <p>“Level Up gave me someone to believe in me until I believed in myself.”</p>
          <footer><cite>Tricia</cite>, Level Up Scholar</footer>
        </blockquote>
        <blockquote class="quote">
          <p>“Witnessing Tricia slowly transform into a confident, self-assured, and proactive young woman has been incredible.”</p>
          <footer><cite>Stephanie</cite>, Tricia's Coach</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="family">
    <div class="wrap">
      <header class="head-center">
        <p class="eyebrow">The Level Up family</p>
        <h2 id="family">{coaches.length} coaches. {scholars.length} scholars. One community.</h2>
        <p class="lede">Every face here is a real Level Up coach or scholar. There's room for one more.</p>
      </header>
      <ul class="family">
        {faces.map((f, i) => <li style={`--i:${i}`}><Img src={f.photo} alt={`${f.name}, Level Up ${f.role}`} widths={[144]} sizes="72px" /></li>)}
        <li style={`--i:${faces.length}`}><a class="you" href="/become-a-coach" aria-label="You? Become a Level Up coach">You?</a></li>
      </ul>
      <p class="center"><a class="text-link arrow" href="/coaches">Meet our coaches</a> <span aria-hidden="true">·</span> <a class="text-link arrow" href="/students">Meet our scholars</a></p>
    </div>
  </section>

  <section class="section soft" aria-labelledby="next-event">
    <div class="wrap narrow">
      <header class="head-center">
        <p class="eyebrow">Next up</p>
        <h2 id="next-event">Come meet the community.</h2>
      </header>
      {next ? <EventItem event={next} featured /> : <p class="center">New events are on the way. Check back soon.</p>}
      <p class="center" style="margin-top:1.5rem"><a class="text-link arrow" href="/events">See all Level Up events</a></p>
    </div>
  </section>

  <section class="section skyline-cta on-navy center" aria-labelledby="cta">
    <div class="bg"><Img src="cincinnati-skyline" alt="" sizes="100vw" widths={[640, 1024, 1600]} /></div>
    <div class="wrap">
      <h2 id="cta">Without support, 1 in 2 first-gen students drop out.</h2>
      <p class="lede">With a coach in their corner, Level Up scholars earn a {s.gpa} average GPA and rate their support {s.supported}.</p>
      <div class="btn-row">
        <a class="btn btn-coral btn-arrow" href="/become-a-coach">Become a coach</a>
        <a class="btn btn-outline" href="/donate">Support a scholar</a>
      </div>
    </div>
  </section>
</Base>
