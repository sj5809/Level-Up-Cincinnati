---
import Base from '../layouts/Base.astro';
import EventItem from '../components/EventItem.astro';
import { getEvents, eventJsonLd } from '../lib/events';

const { upcoming, past, undated } = await getEvents();
const ld = upcoming.map(e => eventJsonLd(e, Astro.site!)).filter(Boolean) as object[];
---
<Base
  title="Events"
  description="Level Up Cincinnati events: HERizon lunch panels, Aiming for Opportunity sporting clays, Urban Bourbon, and Elevating Women. See what's next."
  image="afo-2025"
  crumbs={[{ name: 'Events', path: '/events' }]}
  jsonld={ld}
>
  <section class="hero on-navy">
    <div class="wrap narrow">
      <p class="eyebrow">Events</p>
      <h1>Show up for Cincinnati's first-gen students.</h1>
      <p class="lede">Every Level Up event connects scholars, coaches, and Cincinnati's business community — and every dollar raised supports first-generation college students.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="upcoming">
    <div class="wrap narrow">
      <h2 id="upcoming">Upcoming events</h2>
      {upcoming.length ? (
        <ul class="list-plain grid" style="gap:2rem">{upcoming.map((e, i) => <li><EventItem event={e} featured={i === 0} /></li>)}</ul>
      ) : <p>New dates are on the way. <a href="#footer-newsletter">Join our mailing list</a> to hear first.</p>}
    </div>
  </section>

  <section class="section soft" aria-labelledby="signature">
    <div class="wrap">
      <h2 id="signature">Signature events</h2>
      <div class="grid grid-4">
        <article class="card path-card"><h3>Aiming for Opportunity</h3><p>Our sporting clays fundraiser with Cincinnati's business community — $147K+ raised in two years.</p><a class="text-link arrow" href="/aiming-for-opportunity">Aiming for Opportunity details</a></article>
        <article class="card path-card"><h3>Urban Bourbon</h3><p>An annual, invitation-only evening of exclusive tastings in support of Level Up scholars.</p><a class="text-link arrow" href="/urban-bourbon">Urban Bourbon details</a></article>
        <article class="card path-card"><h3>HERizon Series</h3><p>A free monthly lunch panel connecting young women with female leaders at SparkHaus in Covington.</p><a class="text-link arrow" href="/herizon-series">HERizon Series details</a></article>
        <article class="card path-card"><h3>Elevating Women</h3><p>An annual celebration of first-generation college women, their mentors, and women entrepreneurs.</p><a class="text-link arrow" href="/elevating-women">Elevating Women details</a></article>
      </div>
      {undated.length > 0 && (
        <div style="margin-top:2.5rem">
          <h3>Dates to be announced</h3>
          <ul class="list-plain grid" style="gap:1.5rem">{undated.map(e => <li><EventItem event={e} heading="h4" /></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="past">
    <div class="wrap narrow">
      <h2 id="past">Past events</h2>
      <ul class="list-plain grid" style="gap:1.5rem">{past.map(e => <li><EventItem event={e} past /></li>)}</ul>
    </div>
  </section>

  <section class="section on-navy center" aria-labelledby="help">
    <div class="wrap">
      <h2 id="help">Want to help at an event?</h2>
      <p class="lede">Volunteers make every Level Up event possible. Pick an event and a role that fits.</p>
      <div class="btn-row"><a class="btn btn-coral" href="https://volunteer.levelupcincinnati.org/">Volunteer at an event</a><a class="btn btn-outline" href="/our-partners#partner-form">Sponsor an event</a></div>
    </div>
  </section>
</Base>
