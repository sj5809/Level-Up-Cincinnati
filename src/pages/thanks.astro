---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You" description="Thanks for reaching out to Level Up Cincinnati. We'll be in touch soon." noindex>
  <section class="section center">
    <div class="wrap narrow">
      <h1>Thank you!</h1>
      <p class="lede">We got your message and a real person will follow up soon — usually within a day.</p>
      <div class="btn-row"><a class="btn btn-navy" href="/">Back to home</a><a class="btn btn-coral" href="/donate">Support a scholar</a></div>
    </div>
  </section>
</Base>
